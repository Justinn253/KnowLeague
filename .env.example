DISCORD_FISHING_WEB_NOTIFICATION_CHANNEL_ID=
RIOT_API_KEY=
# Public HTTPS origin used for canonical URLs, sitemap, robots.txt, and social metadata.
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
GOOGLE_CLOUD_VISION_API_KEY=
KNOWLEAGUE_ADMIN_USER_IDS=
KNOWLEAGUE_ADMIN_EMAILS=
RIOT_VIEWER_RATE_LIMIT_REQUESTS=12
RIOT_VIEWER_RATE_LIMIT_WINDOW_MS=60000
RIOT_VIEWER_CACHE_TTL_MS=300000
SUGGESTIONS_RATE_LIMIT_REQUESTS=60
SUGGESTIONS_RATE_LIMIT_WINDOW_MS=60000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SALT=
