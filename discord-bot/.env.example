# Discord application credentials. Keep these only in the bot deployment.
DISCORD_BOT_TOKEN=
# This is the application ID and should match the website's DISCORD_CLIENT_ID.
DISCORD_APPLICATION_ID=
# The one Discord server where KnowLeague commands are available.
DISCORD_GUILD_ID=
# Optional: only successful DISBOARD confirmations in this channel award 2,500 KnowBucks.
DISCORD_BUMP_CHANNEL_ID=

# The canonical public URL of the independently deployed KnowLeague website. Production requires HTTPS and cannot include credentials.
KNOWLEAGUE_SITE_URL=http://localhost:3000
# Optional local browser override for /league account screenshots. The bot Docker image uses /usr/bin/chromium.
# LEAGUE_ACCOUNT_VIEWER_CHROME_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# Server-only Supabase credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
