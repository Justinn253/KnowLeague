{
  "name": "league-quiz-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "discord-bot"
  ],
  "scripts": {
    "dev": "next dev",
    "discord:dev": "npm run dev --workspace=@knowleague/discord-bot",
    "discord:build": "npm run build --workspace=@knowleague/discord-bot",
    "discord:start": "npm run start --workspace=@knowleague/discord-bot",
    "discord:check": "npm run check --workspace=@knowleague/discord-bot",
    "discord:commands:register": "npm run commands:register --workspace=@knowleague/discord-bot",
    "discord:minigame-tiers:generate": "npm run minigame-tiers:generate --workspace=@knowleague/discord-bot",
    "data:generate": "node scripts/generate-catalogs.mjs",
    "data:generate:discord-collections": "node scripts/generate-discord-collection-catalog.mjs",
    "data:generate:champion-abilities": "node scripts/generate-champion-ability-details.mjs",
    "data:generate:champion-hub-overviews": "node scripts/generate-champion-hub-overviews.mjs",
    "data:generate:champion-hub-gameplay-details": "node scripts/generate-champion-hub-gameplay-details.mjs",
    "data:generate:champion-hub-skins": "node scripts/generate-champion-hub-skins.mjs",
    "data:generate:augment-archive": "node scripts/generate-official-augment-catalog.mjs",
    "data:generate:randodraft": "node scripts/generate-randodraft-catalog.mjs",
    "data:generate:riftbound": "node scripts/generate-riftbound-catalog.mjs",
    "data:update:riftbound": "node scripts/update-riftbound-data.mjs",
    "data:import:riftbound-price-history": "node --env-file=.env.local scripts/import-riftbound-price-history.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run discord:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "lucide-react": "^0.500.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.40",
    "supabase": "^2.107.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
